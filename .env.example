PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pyahu
# En la nube: DB_SSL=true y, si el proveedor lo da, su certificado en una línea con \n
DB_SSL=false
DB_SSL_CA=

# Secreto para firmar los tokens: al menos 32 caracteres al azar
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# true deja que cualquiera cree una cuenta. Con false, solo se puede
# registrar el primer usuario (cuando la base no tiene ninguno)
REGISTRO_ABIERTO=false

# Poné 1 cuando la API corre detrás de un proxy (Render, Railway…)
TRUST_PROXY=
